# Data (regenerated by src/pipeline.py from the Chess.com PubAPI)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Datos y caché de otros pipelines del repo (se regeneran; no se versionan)
**/data/*.csv
**/data/*.parquet
**/cache/

# Modelo entrenado: lo regenera notebooks/04_modelado.ipynb
models/

# App web (Next.js): dependencias y build se regeneran con npm
web/node_modules/
web/.next/
web/next-env.d.ts
web/*.tsbuildinfo
web/.env.local

# Jupyter
.ipynb_checkpoints/

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS
.DS_Store
Thumbs.db

# Estado local de agentes de código.
# Las skills versionadas viven en skills/ y se enlazan acá con symlinks.
.claude/*
!.claude/skills/
.opencode/*
!.opencode/skills/

# Docker / Airflow
.env
logs/
plugins/
data/processed/_interim_clean.parquet
