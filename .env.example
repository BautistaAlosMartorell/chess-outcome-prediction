# Variables de entorno para la stack de Airflow (Docker Compose).
# Copiá este archivo como .env y ajustá según tu entorno.
# .env está en .gitignore — nunca subir credenciales al repo.

# ── Usuario web de Airflow ────────────────────────────────────────────────────
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# ── Fernet key (seguridad de conexiones en la UI) ─────────────────────────────
# Generá una con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Dejala vacía en desarrollo; en producción poné una clave real.
AIRFLOW__CORE__FERNET_KEY=

# ── JWT del api-server (Airflow 3) ────────────────────────────────────────────
# Airflow 3 firma con JWT la comunicación entre los workers y el api-server
# (Task Execution API). En desarrollo alcanza con un valor cualquiera; en
# producción poné un secreto real y no lo subas al repo.
AIRFLOW__API_AUTH__JWT_SECRET=dev_jwt_secret_cambiar_en_produccion
